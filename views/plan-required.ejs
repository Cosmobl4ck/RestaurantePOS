<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MarrocosPOS - Función no disponible</title>
    <link rel="icon" href="/img/logo-icon.svg">
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/bootstrap-icons/font/bootstrap-icons.css">
    <style nonce="<%= cspNonce %>">
        body { background-color: #08090A; color: #E8EAED; min-height: 100vh; }
        .plan-card {
            max-width: 720px;
            margin: 3rem auto;
            background: #0D0E10;
            border: 1px solid #1A1D20;
            border-radius: 18px;
            box-shadow: 0 24px 70px rgba(0,0,0,.55);
            overflow: hidden;
        }
        .plan-icon {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            background: rgba(0,161,156,.14);
            border: 1px solid rgba(0,161,156,.45);
            color: #00D2BE;
            font-size: 2rem;
        }
        .plan-chip {
            border: 1px solid rgba(0,161,156,.4);
            border-radius: 999px;
            padding: .35rem .8rem;
            font-size: .85rem;
            color: #00D2BE;
            background: rgba(0,161,156,.08);
        }
        .muted { color: #9AA6AD; }
    </style>
    <link rel="stylesheet" href="/css/petronas.css?v=petronas1">
</head>
<body>
<%- include('partials/navbar') %>

<div class="container">
    <div class="plan-card">
        <div class="p-4 p-md-5 text-center">
            <div class="plan-icon">
                <i class="bi bi-gem"></i>
            </div>
            <h3 class="fw-bold mb-3">Esta función requiere otro plan</h3>
            <p class="muted mb-4"><%= error.message %></p>

            <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
                <span class="plan-chip">
                    Plan actual: <strong><%= currentPlan.nombre %></strong>
                </span>
                <% if (locals.requiredPlan) { %>
                    <span class="plan-chip">
                        Requiere: <strong><%= requiredPlan.nombre %></strong>
                    </span>
                <% } %>
                <% if (locals.limitKey && locals.limit != null) { %>
                    <span class="plan-chip">
                        Uso: <strong><%= usage %> / <%= limit %></strong>
                    </span>
                <% } %>
            </div>

            <% if (locals.featureLabel) { %>
                <p class="small muted mb-4">
                    <i class="bi bi-info-circle me-1"></i>
                    Función: <%= featureLabel %>
                </p>
            <% } %>

            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a href="/mi-plan" class="btn btn-solid-aqua px-4">
                    <i class="bi bi-gem me-1"></i> Ver mi plan
                </a>
                <a href="https://wa.me/50373297072?text=<%= encodeURIComponent('Hola, quiero mejorar mi plan de MarrocosPOS.') %>"
                   target="_blank" rel="noopener" class="btn btn-outline-aqua px-4">
                    <i class="bi bi-whatsapp me-1"></i> Hablar con ventas
                </a>
                <a href="/dashboard" class="btn btn-outline-secondary px-4">
                    Volver al inicio
                </a>
            </div>
        </div>
    </div>
</div>

<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
