<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MarrocosPOS - Gestion de productos</title>
    <link rel="icon" href="/uploads/MarrocosPOS_ico250px.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; }
        .navbar { background-color: #2c3e50; box-shadow: 0 2px 4px rgba(0,0,0,.1); }
        .navbar-brand { color: white !important; font-weight: bold; }
        .card { border: none; box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.05); margin-bottom: 1.5rem; }
        .card-header { background-color: #fff; border-bottom: 2px solid #f8f9fa; font-weight: 600; }
        .search-box { max-width: 300px; }
        .table th { border-top: none; }
        .action-buttons .btn { padding: 0.25rem 0.5rem; }
        .badge-cocina { background-color: #fd7e14; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.8em; }
        .badge-bar { background-color: #6f42c1; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.8em; }
    </style>
</head>
<body>
<%- include('partials/navbar') %>

    <div class="container mt-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center py-3">
                <div>
                    <i class="bi bi-box-fill me-2"></i> Gestión de Productos
                </div>
                <div class="btn-group">
                    <button id="btnNuevoProducto" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
                    </button>
                    <button id="btnDescargarPlantilla" class="btn btn-outline-success">
                        <i class="bi bi-file-earmark-excel"></i> Plantilla Excel
                    </button>
                    <button id="btnImportarProductos" class="btn btn-outline-primary">
                        <i class="bi bi-upload"></i> Importar Excel
                    </button>
                    <input type="file" id="archivoImport" accept=".xlsx" class="d-none">
                </div>
            </div>
            
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col">
                        <div class="input-group search-box ms-auto">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" id="buscarProducto" placeholder="Buscar por código o nombre...">
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th class="text-center">Stock</th>
                                <th class="text-end">Precio</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="productosTabla">
                            <% productos.forEach(function(producto) { %>
                                <tr>
                                    <td><%= producto.codigo %></td>
                                    <td><%= producto.nombre %></td>
                                    <td>
                                        <% if(producto.categoria && producto.categoria.toLowerCase() === 'bar') { %>
                                            <span class="badge-bar">Bar</span>
                                        <% } else { %>
                                            <span class="badge-cocina">Cocina</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <% if(producto.categoria && producto.categoria.toLowerCase() === 'bar') { %>
                                            <span class="<%= (Number(producto.stock) <= Number(producto.stock_minimo)) ? 'text-danger fw-bold' : '' %>">
                                                <%= producto.stock %>
                                            </span>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">$<%= (Number(producto.precio_unidad) || 0).toFixed(2) %></td>
                                    <td class="text-center">
                                        <div class="action-buttons">
                                            <button class="btn btn-sm btn-outline-primary me-1" 
                                                data-id="<%= producto.id %>" 
                                                data-action="editar"
                                                data-stock-minimo="<%= producto.stock_minimo %>">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" data-id="<%= producto.id %>" data-action="eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="nuevoProductoModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-box-fill me-2"></i><span id="modalTitle">Nuevo Producto</span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="formProducto">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-primary">1. Categoría</label>
                            <select class="form-select border-primary" id="categoria" required>
                                <option value="" selected disabled>Seleccione una opción...</option>
                                <option value="cocina">Cocina</option>
                                <option value="bar">Bar (Maneja Inventario)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">2. Código</label>
                            <input type="text" class="form-control bg-light" id="codigo" placeholder="Automático" readonly>
                        </div>
                        <div class="mb-3 d-none bg-light p-2 rounded border" id="stockContainer">
                            <label class="form-label text-primary"><i class="bi bi-boxes"></i> 3. Stock Inicial</label>
                            <input type="number" class="form-control" id="stock" min="0" value="0" disabled>
                        </div>

                        <div class="mb-3 d-none bg-light p-3 rounded border border-warning" id="stockMinimoContainer">
                            <label class="form-label text-warning fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> 3.1 Stock Mínimo (Alerta)</label>
                            <input type="number" class="form-control" id="stock_minimo" min="0" value="5" disabled>
                            <div class="form-text">El sistema avisará cuando el stock sea menor o igual a este número.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">4. Nombre del Producto</label>
                            <input type="text" class="form-control" id="nombre" required disabled>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">5. Precio Unitario</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="precioUnidad" step="0.01" min="0" required disabled>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="guardarProducto">Guardar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Script inline de productos (NO: usar solo productos.js si se habilita). -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        let isEditing = false;
        let editId = null;
        let myModal = new bootstrap.Modal(document.getElementById('nuevoProductoModal'));

        const inputBusqueda = document.getElementById('buscarProducto');
        const tablaCuerpo = document.getElementById('productosTabla');
        const selectCategoria = document.getElementById('categoria');
        const inputNombre = document.getElementById('nombre');
        const inputPrecio = document.getElementById('precioUnidad');
        const inputStock = document.getElementById('stock');
        const inputStockMinimo = document.getElementById('stock_minimo'); // Ref Nueva
        const stockContainer = document.getElementById('stockContainer');
        const stockMinimoContainer = document.getElementById('stockMinimoContainer'); // Ref Nueva
        const inputCodigo = document.getElementById('codigo');

        // BUSCADOR EN TIEMPO REAL
        inputBusqueda.addEventListener('keyup', function() {
            const texto = this.value.toLowerCase().trim();
            const filas = tablaCuerpo.getElementsByTagName('tr');
            for (let i = 0; i < filas.length; i++) {
                const codigo = filas[i].cells[0].textContent.toLowerCase();
                const nombre = filas[i].cells[1].textContent.toLowerCase();
                filas[i].style.display = (codigo.includes(texto) || nombre.includes(texto)) ? "" : "none";
            }
        });

        // LÓGICA DE BLOQUEO SEGÚN CATEGORÍA (Actualizada)
        selectCategoria.addEventListener('change', function() {
            const cat = this.value;
            if (cat === 'bar' || cat === 'cocina') {
                inputNombre.disabled = false;
                inputPrecio.disabled = false;
                if (cat === 'bar') {
                    stockContainer.classList.remove('d-none');
                    stockMinimoContainer.classList.remove('d-none'); // Mostrar Minimo
                    inputStock.disabled = false;
                    inputStockMinimo.disabled = false; // Habilitar Minimo
                } else {
                    stockContainer.classList.add('d-none');
                    stockMinimoContainer.classList.add('d-none'); // Ocultar Minimo
                    inputStock.disabled = true;
                    inputStockMinimo.disabled = true;
                    inputStock.value = 0;
                    inputStockMinimo.value = 0;
                }
            }
        });

        document.getElementById('btnNuevoProducto').addEventListener('click', function() {
            isEditing = false;
            editId = null;
            document.getElementById('modalTitle').textContent = 'Nuevo Producto';
            document.getElementById('formProducto').reset();
            inputNombre.disabled = true;
            inputPrecio.disabled = true;
            inputStock.disabled = true;
            inputStockMinimo.disabled = true;
            stockContainer.classList.add('d-none');
            stockMinimoContainer.classList.add('d-none');
            myModal.show();
        });

        // EDITAR Y ELIMINAR (Actualizada)
        document.querySelector('.table').addEventListener('click', function(e) {
            const button = e.target.closest('button');
            if (!button) return;
            const id = button.dataset.id;
            const action = button.dataset.action;
            const fila = button.closest('tr');

            if (action === 'editar') {
                isEditing = true;
                editId = id;
                document.getElementById('modalTitle').textContent = 'Editar Producto';
                inputNombre.disabled = false;
                inputPrecio.disabled = false;

                inputCodigo.value = fila.cells[0].innerText.trim();
                inputNombre.value = fila.cells[1].innerText.trim();
                inputPrecio.value = parseFloat(fila.cells[4].innerText.replace('$', ''));
                
                const cat = fila.cells[2].innerText.trim().toLowerCase();
                selectCategoria.value = cat;

                if (cat === 'bar') {
                    stockContainer.classList.remove('d-none');
                    stockMinimoContainer.classList.remove('d-none');
                    inputStock.disabled = false;
                    inputStockMinimo.disabled = false;
                    
                    inputStock.value = fila.cells[3].innerText !== '-' ? fila.cells[3].innerText.trim() : 0;
                    // Obtenemos el valor del data-attribute que inyectamos en el EJS
                    inputStockMinimo.value = button.dataset.stockMinimo || 0;
                } else {
                    stockContainer.classList.add('d-none');
                    stockMinimoContainer.classList.add('d-none');
                    inputStock.disabled = true;
                    inputStockMinimo.disabled = true;
                }
                myModal.show();
            } else if (action === 'eliminar') {
                Swal.fire({
                    title: '¿Eliminar?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí'
                }).then((r) => {
                    if (r.isConfirmed) {
                        fetch(`/productos/${id}`, { method: 'DELETE' }).then(() => location.reload());
                    }
                });
            }
        });

        // GUARDAR (Actualizada)
        document.getElementById('guardarProducto').addEventListener('click', async function() {
            const payload = {
                codigo: inputCodigo.value,
                nombre: inputNombre.value,
                categoria: selectCategoria.value,
                stock: inputStock.value,
                stock_minimo: inputStockMinimo.value, // Enviamos el minimo
                precio_unidad: inputPrecio.value
            };
            const url = isEditing ? `/productos/${editId}` : '/productos';
            const response = await fetch(url, {
                method: isEditing ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const result = await response.json().catch(() => ({}));
                Swal.fire({
                    title: 'No se pudo guardar',
                    text: result.detalle || result.error || 'Revisa la terminal para ver el error.',
                    icon: 'error'
                });
                return;
            }

            location.reload();
        });

        document.getElementById('btnDescargarPlantilla').addEventListener('click', () => window.open('/productos/plantilla', '_blank'));
        document.getElementById('btnImportarProductos').addEventListener('click', () => document.getElementById('archivoImport').click());
        document.getElementById('archivoImport').addEventListener('change', async function() {
            const fd = new FormData();
            fd.append('archivo', this.files[0]);
            fetch('/productos/importar', { method: 'POST', body: fd }).then(() => location.reload());
        });
    });
    </script>
</body>
</html>
