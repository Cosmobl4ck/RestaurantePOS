<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MarrocosPOS - Mesas</title>
    <link rel="icon" href="/img/logo-icon.svg">
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/bootstrap-icons/font/bootstrap-icons.css">
    <style nonce="<%= cspNonce %>">
        :root {
            /* Colores extraídos de tu imagen */
            --pos-dark-bg: #0D0E10;      /* Carbono Petronas */
            --pos-teal: #00A19C;         /* Petronas Teal */
            --pos-teal-hover: #00D2BE;   /* Petronas Teal brillante */
            --pos-teal-light: rgba(0,161,156,0.12); /* Fondo teal translúcido */
        }

        body { background-color: #08090A; color: #E8EAED; }
        
        /* Navbar global */
        .navbar {
            background-color: var(--pos-dark-bg) !important;
            box-shadow: 0 2px 4px rgba(0,0,0,.1);
        }
        
        /* Clase personalizada para fondos oscuros de la marca */
        .bg-petronas {
            background-color: var(--pos-dark-bg) !important;
        }

        /* Clases personalizadas para el color Teal de la marca */
        .bg-teal {
            background-color: var(--pos-teal) !important;
            color: white !important;
        }
        .text-teal {
            color: var(--pos-teal) !important;
        }
        .border-teal {
            border-color: var(--pos-teal) !important;
        }
        
        /* Botón personalizado Teal */
        .btn-teal {
            background-color: var(--pos-teal);
            border-color: var(--pos-teal);
            color: #06110F;
        }
        .btn-teal:hover {
            background-color: var(--pos-teal-hover);
            border-color: var(--pos-teal-hover);
            color: #06110F;
        }

        .mesa-card {
            border: none;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,.05);
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
            border-radius: 12px;
            overflow: hidden;
        }
        .mesa-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
        .card-especial {
            border: 2px dashed var(--pos-teal) !important;
            background-color: var(--pos-teal-light) !important;
        }
        .card-especial.bg-teal {
            border: 2px solid var(--pos-teal-hover) !important;
        }
        .offcanvas-body {
            background-color: #0D0E10;
            color: #E8EAED;
        }
        .table-items td {
            vertical-align: middle;
        }
        
        /* Ajuste para el icono del header offcanvas */
        .offcanvas-header .btn-close-white {
            filter: invert(1) grayscale(100%) brightness(200%);
        }

        /* Resultados del buscador de productos */
        .producto-resultado {
            display: flex;
            align-items: stretch;
            padding: 0 !important;
            overflow: hidden;
        }
        .producto-resultado-main {
            flex: 1;
            min-width: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .5rem;
            border: 0;
            background: transparent;
            color: #212529;
            text-align: left;
            padding: .65rem .8rem;
        }
        .producto-resultado-main:hover { background: rgba(0,161,156,.08); }
        .producto-resultado-main .producto-meta {
            display: flex;
            align-items: center;
            gap: .5rem;
            flex-wrap: wrap;
            margin-top: 2px;
            font-size: .72rem;
        }
        .producto-info-btn {
            width: 48px;
            flex-shrink: 0;
            border: 0;
            border-left: 1px solid rgba(0,161,156,.25);
            background: rgba(0,161,156,.08);
            color: var(--pos-teal);
            font-size: 1.1rem;
        }
        .producto-info-btn:hover {
            background: rgba(0,161,156,.2);
            color: var(--pos-teal-hover);
        }

        /* Ficha de producto */
        #modalInfoProducto .modal-content {
            background: #0D0E10;
            color: #E8EAED;
            border: 1px solid rgba(0,161,156,.45);
        }
        #modalInfoProducto .modal-header,
        #modalInfoProducto .modal-footer {
            border-color: rgba(255,255,255,.12);
        }
        #modalInfoProducto .modal-body {
            max-height: 70vh;
            overflow-y: auto;
        }
        .info-label {
            color: var(--pos-teal);
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
        }
        .alergeno-chip {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .28rem .6rem;
            border-radius: 99px;
            background: rgba(220,53,69,.18);
            border: 1px solid rgba(220,53,69,.55);
            color: #FF9AA5;
            font-size: .78rem;
            font-weight: 700;
        }
        .info-sin-alergenos {
            color: #5EE0B5;
            font-size: .85rem;
            font-weight: 600;
        }
    </style>
    <link rel="stylesheet" href="/css/petronas.css?v=petronas2">
</head>
<body>
    
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0 fw-bold text-dark">
                <i class="bi bi-shop me-2 text-teal"></i>Punto de Venta / Entregas
            </h4>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-4" role="tablist" aria-label="Zonas del restaurante">
            <a href="/mesas?zona=zonas" class="btn btn-sm <%= zonaActiva === 'zonas' ? 'btn-teal' : 'btn-outline-secondary' %>">
                <i class="bi bi-grid me-1"></i>Zonas
            </a>
            <a href="/mesas?zona=todas" class="btn btn-sm <%= zonaActiva === 'todas' ? 'btn-teal' : 'btn-outline-secondary' %>">
                <i class="bi bi-grid-3x3-gap me-1"></i>Todas
                <span class="badge text-bg-light ms-1"><%= areas.reduce((acc, a) => acc + a.total, 0) + especialesCount %></span>
            </a>
            <% areas.forEach(function (area) { %>
                <a href="/mesas?zona=<%= area.id %>" class="btn btn-sm <%= String(zonaActiva) === String(area.id) ? 'btn-teal' : 'btn-outline-secondary' %>">
                    <i class="bi bi-geo-alt me-1"></i><%= area.nombre %>
                    <span class="badge text-bg-light ms-1"><%= area.ocupadas %>/<%= area.total %></span>
                </a>
            <% }); %>
            <% if (especialesCount > 0) { %>
                <a href="/mesas?zona=especiales" class="btn btn-sm <%= zonaActiva === 'especiales' ? 'btn-teal' : 'btn-outline-secondary' %>">
                    <i class="bi bi-bag-check me-1"></i>Especiales
                    <span class="badge text-bg-light ms-1"><%= especialesCount %></span>
                </a>
            <% } %>
        </div>

        <% if (zonaActiva === 'especiales' && puedeAgregarEspecial) { %>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <button type="button" class="btn btn-sm btn-outline-light" data-especial="llevar">
                <i class="bi bi-plus-circle me-1"></i>Agregar para llevar
            </button>
            <button type="button" class="btn btn-sm btn-outline-light" data-especial="domicilio">
                <i class="bi bi-plus-circle me-1"></i>Agregar a domicilio
            </button>
        </div>
        <% } %>

        <% if (zonaActiva === 'zonas') { %>
        <div class="row g-4">
            <% areas.forEach(function (area) { %>
                <div class="col-12 col-md-4">
                    <a href="/mesas?zona=<%= area.id %>" class="text-decoration-none">
                        <div class="card h-100 p-4 shadow-sm">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h3 class="h5 fw-bold mb-0 text-teal"><%= area.nombre %></h3>
                                <span class="badge text-bg-<%= area.ocupadas > 0 ? 'warning' : 'success' %>">
                                    <%= area.ocupadas %>/<%= area.total %> ocupadas
                                </span>
                            </div>
                            <div class="row text-center g-2">
                                <div class="col-6">
                                    <div class="small text-muted">Personas</div>
                                    <div class="fw-bold"><%= area.personas %>/<%= area.capacidad %></div>
                                </div>
                                <div class="col-6">
                                    <div class="small text-muted">Disponibles</div>
                                    <div class="fw-bold text-success"><%= area.disponibles %></div>
                                </div>
                                <div class="col-6">
                                    <div class="small text-muted">Mesas libres</div>
                                    <div class="fw-bold"><%= area.libres %></div>
                                </div>
                                <div class="col-6">
                                    <div class="small text-muted">Total mesas</div>
                                    <div class="fw-bold"><%= area.total %></div>
                                </div>
                            </div>
                            <div class="mt-3 text-teal small fw-bold">Abrir mesas →</div>
                        </div>
                    </a>
                </div>
            <% }); %>
            <% if (especialesCount > 0) { %>
                <div class="col-12 col-md-4">
                    <a href="/mesas?zona=especiales" class="text-decoration-none">
                        <div class="card h-100 p-4 shadow-sm">
                            <h3 class="h5 fw-bold mb-3 text-teal">Especiales</h3>
                            <div class="small text-muted mb-1">Para llevar y a domicilio</div>
                            <div class="fw-bold"><%= especialesCount %> mesas</div>
                            <div class="mt-3 text-teal small fw-bold">Abrir mesas →</div>
                        </div>
                    </a>
                </div>
            <% } %>
        </div>
        <% } else { %>
        <div class="row g-4">
            <% mesas.forEach(m => { %>
                <% 
                    let cardClass = 'bg-white border text-secondary'; 
                    let icon = 'bi-plus-circle';
                    let titleColor = 'text-dark';
                    
                    let nombreMesa = m.numero.toLowerCase();
                    let esMostrador = (nombreMesa.includes('mostrador') || m.numero === '99');
                    let esDomicilio = (nombreMesa.includes('domicilio'));
                    let esLlevar = (nombreMesa.includes('llevar'));

                    if (m.estado === 'ocupada') {
                        cardClass = 'bg-teal shadow';
                        icon = 'bi-person-fill';
                        titleColor = 'text-white';
                    } else if (esMostrador || esDomicilio || esLlevar) {
                        cardClass += ' card-especial'; 
                    }
                %>

                <div class="col-6 col-md-4 col-lg-3 col-xl-2"> 
                    <div class="card h-100 text-center p-3 mesa-card <%= cardClass %>"
                        data-mesa-id="<%= m.id %>" data-mesa-numero="<%= m.numero %>" data-mesa-estado="<%= m.estado %>"
                        data-mesa-capacidad="<%= Number(m.capacidad || 1) %>">
                        
                        <div class="card-body p-2 d-flex flex-column justify-content-center align-items-center">
                            <h3 class="fw-bold mb-1 <%= titleColor %>" style="font-size: 1.2rem;">
                                <% if(esMostrador) { %>
                                    <i class="bi bi-bag-check d-block mb-1"></i> Mostrador
                                <% } else if(esDomicilio) { %>
                                    <i class="bi bi-truck d-block mb-1"></i> Domicilio
                                <% } else if(esLlevar) { %>
                                    <i class="bi bi-box-seam d-block mb-1"></i> Para Llevar
                                <% } else { %>
                                    <%= m.numero %>
                                <% } %>
                            </h3>
                            
                            <small class="d-block mb-2 text-uppercase fw-bold" style="font-size: 0.7rem; opacity: 0.8;">
                                <%= m.estado %> · <%= Number(m.capacidad || 0) %> pers.
                            </small>
                            
                            <div class="mt-auto w-100">
                                <% if (m.estado === 'ocupada') { %>
                                    <div class="badge bg-white text-teal text-truncate w-100 p-2 shadow-sm rounded-pill">
                                        <i class="bi bi-people-fill me-1"></i> <%= Number(m.personas_actuales || 0) %> clientes
                                    </div>
                                    <% if (m.descripcion) { %>
                                        <small class="d-block text-white-50 mt-1 text-truncate"><%= m.descripcion %></small>
                                    <% } %>
                                <% } else { %>
                                    <i class="<%= icon %> fs-2 opacity-50"></i>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
        <% } %>
    </div>

    <!-- Offcanvas para Pedidos -->
    <div class="offcanvas offcanvas-end shadow" tabindex="-1" id="canvasPedido">
        
        <!-- HEADER ACTUALIZADO CON COLORES DE LA MARCA -->
        <div class="offcanvas-header bg-petronas text-white border-bottom border-teal" style="border-bottom-width: 3px !important;">
            <h5 class="offcanvas-title fw-bold">
                <i class="bi bi-receipt me-2 text-teal"></i>Pedido: <span id="pedidoMesa" class="text-teal"></span>
            </h5>
            <div class="d-flex align-items-center gap-2">
                <% if (typeof locals.planPuede !== 'function' || locals.planPuede('pos.mover_pedido')) { %>
                <button type="button" id="btnMoverMesaHeader" class="btn btn-outline-light btn-sm" data-bs-toggle="tooltip" title="Mover a otra mesa">
                    <i class="bi bi-arrow-left-right"></i>
                </button>
                <% } %>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
            </div>
        </div>
        
        <div class="offcanvas-body d-flex flex-column p-3">
            <!-- Sección de búsqueda -->
            <div class="mb-3" id="contenedorNombreCliente" style="display: none;">
                <label class="form-label small fw-bold text-muted mb-1">Nombre del Cliente / Referencia:</label>
                <input type="text" id="nombreClienteModal" class="form-control form-control-sm border-teal" placeholder="Ej. Juan Pérez">
            </div>

            <div class="mb-3 position-relative">
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white border-end-0 text-teal">
                        <i class="bi bi-search"></i>
                    </span>
                    <input id="buscarProductoMesa" class="form-control border-start-0 ps-0 border-teal" placeholder="Buscar producto para agregar..." autocomplete="off">
                </div>
                <div id="resultadosProductoMesa" class="list-group position-absolute w-100 shadow" style="z-index: 1050; display: none; max-height: 200px; overflow-y: auto;"></div>
            </div>
            
            <div class="d-flex justify-content-end mb-2">
                <button id="btnLiberarMesaHeader" class="btn btn-outline-danger btn-sm rounded-pill">
                    <i class="bi bi-trash3 me-1"></i> Cancelar / Liberar
                </button>
            </div>
            
            <div class="table-responsive flex-grow-1 border rounded bg-white shadow-sm mb-3">
                <table class="table table-sm table-hover table-items mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th class="ps-3">Producto</th>
                            <th class="text-center" style="width: 15%;">Cant</th>
                            <th class="text-end" style="width: 25%;">Subt</th>
                            <th style="width: 10%;"></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyItems"></tbody>
                </table>
            </div>
            
            <div class="mt-auto bg-white p-3 border rounded shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted fw-bold text-uppercase">Total a Pagar:</span>
                    <span id="totalPedido" class="fw-bold fs-3 text-teal">$0.00</span>
                </div>
                <div id="propinaPedido" class="text-end small text-muted mb-3" hidden></div>
                
                <div class="d-grid gap-2">
                    <!-- BOTÓN DE COBRO: Solo para Admin y Cajero -->
                    <% if (usuario && ['admin', 'gerente', 'cajero'].includes(usuario.rol)) { %>
                        <button id="btnFacturarPedido" class="btn btn-teal btn-lg fw-bold shadow-sm mb-1">
                            <i class="bi bi-cash-coin me-2"></i>Cobrar
                        </button>
                    <% } else { %>
                        <div class="alert alert-info py-2 px-3 text-center mb-2 small shadow-sm border-0">
                            <i class="bi bi-info-circle me-1"></i> Solo los cajeros pueden procesar pagos.
                        </div>
                    <% } %>
                    
                    <!-- BOTÓN DE GUARDAR: Siempre habilitado -->
                    <button id="btnEnviarCocina" class="btn btn-teal w-100 fw-bold btn-lg shadow-sm">
                        <i class="bi bi-send me-1"></i> Enviar comanda
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Ficha informativa del producto -->
    <div class="modal fade" id="modalInfoProducto" tabindex="-1" aria-labelledby="modalInfoProductoTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalInfoProductoTitle">
                        <i class="bi bi-info-circle me-2 text-teal"></i>Información del platillo
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h4 class="fw-bold mb-1" id="infoProductoNombre"></h4>
                            <div class="small text-secondary" id="infoProductoCodigo"></div>
                        </div>
                        <span class="badge bg-teal fs-6" id="infoProductoPrecio"></span>
                    </div>

                    <p class="text-secondary mb-3" id="infoProductoDescripcion"></p>

                    <div class="mb-3">
                        <div class="info-label mb-1">Ingredientes</div>
                        <p class="mb-0" id="infoProductoIngredientes"></p>
                    </div>

                    <div class="mb-3">
                        <div class="info-label mb-2">Alérgenos</div>
                        <div class="d-flex flex-wrap gap-2" id="infoProductoAlergenos"></div>
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-clock-history text-teal"></i>
                        <span>Tiempo aproximado: <strong id="infoProductoTiempo"></strong></span>
                    </div>

                    <div class="alert alert-danger py-2 px-3 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        La información de alérgenos es declarada por el restaurante. Si el cliente tiene una alergia grave, confirma con cocina.
                    </div>

                    <div class="border-top border-secondary pt-3">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="infoProductoAlergiaCheck">
                            <label class="form-check-label fw-semibold" for="infoProductoAlergiaCheck">
                                El cliente tiene una alergia que debo avisar
                            </label>
                        </div>
                        <input type="text" id="infoProductoAlergiaDetalle" class="form-control bg-dark text-white border-secondary" maxlength="200" placeholder="Ej. maní, lactosa, mariscos..." disabled>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" class="btn btn-teal fw-bold" id="btnAgregarDesdeInfo">
                        <i class="bi bi-plus-lg me-1"></i>Agregar al pedido
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="/vendor/jquery/jquery-3.6.0.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/vendor/sweetalert2/sweetalert2.all.min.js"></script>
    <script nonce="<%= cspNonce %>">window.POS_PROPINA_PORCENTAJE = <%= Number(propinaPorcentaje || 0) %>;</script>
    <script src="/js/mesas.js"></script>

    <script nonce="<%= cspNonce %>">
    document.getElementById('btnMoverMesaHeader')?.addEventListener('click', async function() {
    // 1. Extraer IDs usando los nombres exactos detectados en consola
    const $pedidoMesa = $('#pedidoMesa');
    
    // data('pedido-id') coincide con como lo setea mesas.js: .data('pedido-id', ...)
    const pedidoId = $pedidoMesa.data('pedido-id'); 
    const mesaOrigenId = $pedidoMesa.data('id'); 
    const numeroMesaOrigen = document.getElementById('pedidoMesa').innerText;

    // Log de depuración para que confirmes en consola que ahora sí cargan
    console.log("Detectado -> Pedido:", pedidoId, "Mesa Origen:", mesaOrigenId);

    // 2. Validación inmediata
    if (!pedidoId || !mesaOrigenId) {
        return swalPos({
            icon: 'error',
            title: 'Error de datos',
            text: `No se pudo obtener la información (P:${pedidoId} M:${mesaOrigenId}).`,});
    }

    const canvasEl = document.getElementById('canvasPedido');

    try {
        // 3. Obtener mesas libres
        const resp = await fetch('/mesas/listar');
        if (!resp.ok) throw new Error('Error al conectar con el servidor');
        
        const mesas = await resp.json();
        
        // Filtramos para que no aparezca la misma mesa donde ya está el pedido
        const mesasLibres = mesas.filter(m => 
            String(m.estado).toLowerCase() === 'libre' && m.id != mesaOrigenId
        );

        if (mesasLibres.length === 0) {
            return swalPos({
                title: 'Sin espacio',
                text: 'No hay otras mesas libres disponibles.',
                icon: 'warning',});
        }

        const opciones = {};
        mesasLibres.forEach(m => { opciones[m.id] = `${m.numero}`; });

        // 4. Preguntar destino
        const { value: mesaDestinoId } = await swalPos({
            title: 'Mover pedido',
            text: `¿A qué mesa quieres trasladar el pedido de ${numeroMesaOrigen}?`,
            input: 'select',
            inputOptions: opciones,
            inputPlaceholder: 'Selecciona destino...',
            showCancelButton: true,
            confirmButtonText: 'Trasladar Ahora',
            confirmButtonColor: '#00A19C', /* Petronas Teal */});

        if (mesaDestinoId) {
            swalPos({ 
                title: 'Procesando...', 
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading() 
            });

            const response = await fetch('/mesas/mover-pedido', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    pedido_id: pedidoId,
                    mesa_origen_id: mesaOrigenId,
                    mesa_destino_id: mesaDestinoId
                })
            });

            const result = await response.json();
            
            if (result.success) {
                await swalPos({
                    icon: 'success',
                    title: '¡Movimiento Exitoso!',
                    text: `Pedido trasladado a la mesa ${opciones[mesaDestinoId]}`,
                    confirmButtonColor: '#00A19C'
                });
                location.reload();
            } else {
                throw new Error(result.error || 'Error desconocido');
            }
        }
    } catch (error) {
        console.error("❌ Error en movimiento:", error);
        swalPos({
            icon: 'error',
            title: 'No se pudo mover',
            text: error.message,});
    }
});

    document.getElementById('btnLiberarMesaHeader').addEventListener('click', async function() {

    const $pedidoMesa = $('#pedidoMesa');
    const mesaId   = $pedidoMesa.data('id');
    const pedidoId = $pedidoMesa.data('pedido-id');
    const canvasEl = document.getElementById('canvasPedido');

    if (!mesaId) {
        return swalPos({ icon: 'warning', title: 'Sin mesa seleccionada',});
    }

    try {

        // =====================================================
        // CASO 1: YA EXISTE PEDIDO GUARDADO 🧾
        // =====================================================
        if (pedidoId) {

            const { isConfirmed } = await swalPos({
                icon: 'warning',
                title: 'Limpiar ticket actual',
                text: 'Se cancelará el pedido completo, se devolverá su stock y la mesa quedará disponible si no tiene otro pedido activo.',
                showCancelButton: true,
                confirmButtonText: 'Sí, cancelar pedido',
                cancelButtonText: 'Volver',
                confirmButtonColor: '#EF4444',});

            if (!isConfirmed) return;

            swalPos({
                title: 'Limpiando...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            const resp = await fetch(`/mesas/pedidos/${pedidoId}`, {
                method: 'DELETE'
            });

            const data = await resp.json();
            if (!resp.ok) throw new Error(data.error || 'No se pudo limpiar el ticket');

            await swalPos({
                icon: 'success',
                title: 'Pedido cancelado',
                text: 'El stock y el estado de la mesa fueron conciliados.',
                timer: 1500,
                showConfirmButton: false
            });

            location.reload();
            return;
        }

        await swalPos({
            icon: 'info',
            title: 'Sin pedido activo',
            text: 'No existe un pedido que pueda cancelarse desde esta pantalla.',});

    } catch (err) {
        console.error('❌ Error:', err);
        swalPos({
            icon: 'error',
            title: 'Error',
            text: err.message,});
    }
});    
    </script>
</body>
</html>
