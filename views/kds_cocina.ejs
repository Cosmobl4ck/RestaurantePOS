<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cocina — MarrocosPOS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        * { box-sizing: border-box; }
        body {
            background: #08090A;
            color: #E8EAED;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
            margin: 0;
        }
        .kds-header {
            background: #0D0E10;
            padding: .75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: .5rem;
            border-bottom: 3px solid #00A19C;
            box-shadow: 0 8px 26px rgba(0,0,0,.50);
        }
        .kds-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #00A19C;
            margin: 0;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        .kds-nav {
            display: flex;
            align-items: center;
            gap: .45rem;
            flex-wrap: wrap;
        }
        .kds-nav-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            padding: 0;
            border-radius: 10px;
            color: #E8EAED;
            background: rgba(0,161,156,.10);
            border: 1px solid rgba(0,161,156,.30);
            text-decoration: none;
            transition: all .2s ease;
        }
        .kds-nav-btn:hover { background: rgba(0,161,156,.22); color: #00D2BE; transform: translateY(-1px); }
        .kds-nav-btn i { font-size: 1.1rem; }
        .kds-clock {
            font-size: 1.6rem;
            font-weight: 700;
            color: #E8EAED;
            font-variant-numeric: tabular-nums;
        }
        .kds-status {
            font-size: .75rem;
            padding: 4px 12px;
            border-radius: 99px;
            font-weight: 600;
        }
        .status-live { background: #00A19C; color: #06110F; }
        .status-offline { background: #EF4444; color: #FFFFFF; }

        #grid-comandas {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 16px;
            padding: 1.5rem;
            height: calc(100vh - 80px);
            overflow-y: auto;
        }

        .comanda-card {
            background: #0D0E10;
            border: 3px solid #1A1D20;
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            animation: slideIn .3s ease;
            transition: transform .2s, box-shadow .2s;
            box-shadow: 0 12px 28px rgba(0,0,0,.35);
        }
        .comanda-card:hover { transform: translateY(-4px); box-shadow: 0 16px 34px rgba(0,0,0,.50), 0 0 0 1px rgba(0,161,156,.25); }
        .comanda-card.cocina.preparando { border-color: #00A19C; }
        .comanda-card.cocina.listo { border-color: #00D2BE; }

        .comanda-header {
            padding: .8rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #121518;
        }
        .comanda-card.cocina.preparando .comanda-header { background: rgba(0,161,156,.18); }
        .comanda-card.cocina.listo .comanda-header { background: rgba(0,210,190,.18); }

        .comanda-mesa {
            font-size: 1.3rem;
            font-weight: 700;
            color: #FFFFFF;
        }
        .comanda-hora {
            font-size: .8rem;
            color: #9AA6AD;
            font-variant-numeric: tabular-nums;
        }
        .tiempo-badge {
            font-size: .75rem;
            padding: 3px 10px;
            border-radius: 99px;
            font-weight: 600;
            background: rgba(0,161,156,.16);
            color: #00D2BE;
        }
        .tiempo-badge.urgente { background: #EF4444; color: #FFFFFF; animation: pulse 1s infinite; }

        .comanda-items {
            padding: 1rem;
            flex: 1;
            overflow-y: auto;
        }
        .comanda-item {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            padding: .5rem 0;
            border-bottom: 1px solid rgba(255,255,255,.07);
        }
        .comanda-item:last-child { border-bottom: none; }
        
        .item-qty {
            background: #00A19C;
            color: #06110F;
            font-weight: 700;
            font-size: 1rem;
            min-width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .item-nombre { 
            font-size: 1rem; 
            font-weight: 600; 
            color: #E8EAED;
            word-break: break-word;
        }
        .item-nota { 
            font-size: .8rem; 
            color: #F59E0B;
            margin-top: 3px;
            font-style: italic;
        }

        .comanda-actions {
            padding: 1rem;
            display: flex;
            gap: 10px;
        }
        .btn-kds {
            flex: 1;
            border: none;
            border-radius: 8px;
            padding: .6rem;
            font-size: .85rem;
            font-weight: 700;
            cursor: pointer;
            transition: opacity .15s, transform .15s;
            color: #06110F;
        }
        .btn-kds:active { opacity: .75; transform: scale(0.98); }
        .btn-preparar { background: #00A19C; color: #06110F; }
        .btn-listo { background: #00D2BE; color: #06110F; }
        .btn-finalizar { background: #121518; border: 1px solid rgba(0,161,156,.45); color: #00D2BE; }

        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 6rem 2rem;
            color: #9AA6AD;
        }
        .empty-state i { font-size: 5rem; display: block; margin-bottom: 1.5rem; }

        #toast-container {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .kds-toast {
            background: #0D0E10;
            border: 2px solid #00A19C;
            color: #E8EAED;
            border-radius: 10px;
            padding: .8rem 1.2rem;
            font-size: .9rem;
            animation: slideIn .3s ease;
            box-shadow: 0 12px 28px rgba(0,0,0,.45);
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(-12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        @media (max-width: 768px) {
            #grid-comandas {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <link rel="stylesheet" href="/css/petronas.css?v=petronas1">
</head>
<body>

<div class="kds-header">
    <h1><i class="bi bi-egg-fried me-2"></i>Cocina</h1>
    <div class="d-flex align-items-center gap-3 flex-wrap justify-content-end">
        <% if (['admin', 'gerente', 'cajero'].includes(usuario.rol)) { %>
            <div class="kds-nav">
                <a href="/mesas" class="kds-nav-btn" title="Mesas"><i class="bi bi-grid"></i></a>
                <a href="/registro-pedidos" class="kds-nav-btn" title="Pedidos"><i class="bi bi-list-check"></i></a>
                <a href="/facturas" class="kds-nav-btn" title="Facturas"><i class="bi bi-receipt-cutoff"></i></a>
                <a href="/ventas" class="kds-nav-btn" title="Ventas"><i class="bi bi-cash-coin"></i></a>
            </div>
        <% } %>
        <span id="realtime-status" class="kds-status status-offline">Sin conexión</span>
        <div class="kds-clock" id="reloj">--:--:--</div>
        <form action="/logout" method="post" class="d-inline">
            <button type="submit" class="kds-nav-btn" title="Cerrar Sesión"><i class="bi bi-box-arrow-right"></i></button>
        </form>
    </div>
</div>

<div id="grid-comandas">
    <div class="empty-state">
        <i class="bi bi-clock-history"></i>
        <p>Cargando comandas...</p>
    </div>
</div>

<div id="toast-container"></div>

<script>
    window.tipoMonitor = 'cocina';
</script>
<script src="/js/kds.js"></script>

</body>
</html>
