<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MarrocosPOS - Caja cerrada</title>
    <link rel="icon" href="/img/logo-icon.svg">
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/bootstrap-icons/font/bootstrap-icons.css">
    <style nonce="<%= cspNonce %>">
        body { background-color: #08090A; color: #E8EAED; }
        .caja-cerrada { max-width: 640px; margin: 60px auto; }
        .caja-cerrada .bi-lock-fill { font-size: 3rem; color: #FFC107; }
    </style>
    <link rel="stylesheet" href="/css/petronas.css?v=petronas2">
</head>
<body>
<%- include('partials/navbar') %>

    <div class="container">
        <div class="card shadow caja-cerrada">
            <div class="card-body text-center p-5">
                <i class="bi bi-lock-fill"></i>
                <h2 class="h4 mt-3">Caja cerrada</h2>
                <p class="text-muted">
                    No hay una caja abierta. El POS, mesas, KDS, comandas y facturación
                    están bloqueados hasta que se abra la caja.
                </p>

                <% if (puedeAbrir) { %>
                    <a href="/caja" class="btn btn-primary btn-lg mt-2">
                        <i class="bi bi-cash-coin me-1"></i>Abrir caja
                    </a>
                    <p class="small text-muted mt-3 mb-0">
                        Atajo: <kbd>Alt</kbd> + <kbd>H</kbd> para abrir caja.
                    </p>
                <% } else { %>
                    <p class="small text-muted mt-2 mb-0">
                        Pide al cajero o al administrador que abra la caja.
                    </p>
                <% } %>
            </div>
        </div>
    </div>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <% if (puedeAbrir) { %>
    <script nonce="<%= cspNonce %>">
        document.addEventListener('keydown', (event) => {
            if (event.altKey && !event.ctrlKey && !event.metaKey && String(event.key).toLowerCase() === 'h') {
                event.preventDefault();
                window.location.assign('/caja');
            }
        });
    </script>
    <% } %>
</body>
</html>
