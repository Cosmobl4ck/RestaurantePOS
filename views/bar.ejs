<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitor de Bar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; }
        .card-pedido { transition: transform 0.2s; border: none; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .card-pedido:hover { transform: translateY(-3px); }
        .badge-cantidad { font-size: 1.1em; padding: 0.4em 0.7em; }
        .bg-gradient-blue { background: linear-gradient(45deg, #0d6efd, #0a58ca); color: white; }
        .bg-gradient-green { background: linear-gradient(45deg, #198754, #146c43); color: white; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark mb-4 px-3">
        <span class="navbar-brand"><i class="bi bi-cup-straw"></i> Monitor de Bar</span>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white"><%= user ? `Hola, ${user.nombre}` : '' %></span>
            <a href="/" class="btn btn-outline-light btn-sm">Ir a Inicio</a>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <div id="contenedor-pedidos" class="row g-4">
            <div class="col-12 text-center mt-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2">Cargando pedidos...</p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> <script>
        // Función principal de carga
        async function cargarPedidos() {
            const contenedor = document.getElementById('contenedor-pedidos');
            
            try {
                const response = await fetch('/bar/pedidos-activos');
                if (!response.ok) throw new Error('Error de red');
                const pedidos = await response.json();
                
                // 1. Caso: No hay pedidos
                if (!Array.isArray(pedidos) || pedidos.length === 0) {
                    contenedor.innerHTML = `
                        <div class="col-12 text-center mt-5 text-muted opacity-50">
                            <i class="bi bi-cup-hot display-1"></i>
                            <h3 class="mt-3">Todo limpio</h3>
                            <p>No hay bebidas pendientes.</p>
                        </div>`;
                    return;
                }

                // 2. Generar HTML
                let html = '';
                
                pedidos.forEach(pedido => {
                    // Parsear items con seguridad
                    let items = [];
                    try {
                        items = typeof pedido.productos === 'object' ? pedido.productos : JSON.parse(pedido.productos);
                    } catch (e) { items = []; }

                    // LÓGICA INTELIGENTE:
                    // Verificamos el estado de CADA item. Si todos dicen 'listo', la tarjeta es verde.
                    // Si alguno dice 'enviado', la tarjeta es azul.
                    const todosListos = items.every(i => i.estado_item === 'listo');
                    const esListo = todosListos; 

                    // Renderizar lista de productos
                    let listaHtml = items.map(item => `
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge ${esListo ? 'bg-success' : 'bg-primary'} rounded-pill badge-cantidad me-2">${item.cantidad}</span>
                                <span class="fw-bold fs-5">${item.nombre}</span>
                                ${item.nota ? `<div class="text-danger small mt-1"><i class="bi bi-exclamation-circle"></i> ${item.nota}</div>` : ''}
                            </div>
                            ${item.estado_item === 'listo' ? '<i class="bi bi-check-circle-fill text-success"></i>' : ''}
                        </li>
                    `).join('');

                    // Configurar colores y botones según estado
                    const colorHeader = esListo ? 'bg-gradient-green' : 'bg-gradient-blue';
                    const textoEstado = esListo ? '¡Listo para llevar!' : 'Por preparar';
                    
                    // BOTÓN: Si está listo -> Entregar (Borrar). Si no -> Marcar Listo.
                    const boton = esListo 
                        ? `<button onclick="cambiarEstado(${pedido.id}, 'entregado')" class="btn btn-success w-100 py-3 fw-bold fs-5 animate-pulse"><i class="bi bi-check2-all"></i> ENTREGAR Y BORRAR</button>`
                        : `<button onclick="cambiarEstado(${pedido.id}, 'listo')" class="btn btn-outline-primary w-100 py-3 fw-bold"><i class="bi bi-check-lg"></i> MARCAR LISTO</button>`;

                    html += `
                    <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                        <div class="card card-pedido h-100 border-0 shadow">
                            <div class="card-header ${colorHeader} d-flex justify-content-between align-items-center py-3">
                                <h4 class="mb-0 fw-bold"><i class="bi bi-shop-window"></i> Mesa ${pedido.mesa}</h4>
                                <span class="badge bg-light text-dark shadow-sm">${textoEstado}</span>
                            </div>
                            <div class="card-body bg-light">
                                <div class="d-flex justify-content-between text-muted mb-2 small">
                                    <span><i class="bi bi-person"></i> ${pedido.cliente || 'Cliente'}</span>
                                    <span><i class="bi bi-clock"></i> ${new Date(pedido.created_at).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</span>
                                </div>
                                <ul class="list-group shadow-sm mb-3">
                                    ${listaHtml}
                                </ul>
                            </div>
                            <div class="card-footer bg-white p-2">
                                ${boton}
                            </div>
                        </div>
                    </div>`;
                });

                contenedor.innerHTML = html;

            } catch (error) {
                console.error(error);
            }
        }

        async function cambiarEstado(id, nuevoEstado) {
            try {
                // Feedback visual inmediato (opcional)
                const res = await fetch(`/bar/pedidos/${id}/estado`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ estado: nuevoEstado })
                });
                
                if(res.ok) {
                    cargarPedidos(); // Recargar inmediatamente
                } else {
                    Swal.fire('Error', 'No se pudo actualizar', 'error');
                }
            } catch (e) { console.error(e); }
        }

        document.addEventListener('DOMContentLoaded', () => {
            cargarPedidos();
            setInterval(cargarPedidos, 3000); // 3 segundos para que se sienta más rápido
        });
    </script>
    
    <style>
        /* Animación para el botón de entregar */
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.02); }
            100% { transform: scale(1); }
        }
        .animate-pulse { animation: pulse 1.5s infinite; }
    </style>
</body>
</html>