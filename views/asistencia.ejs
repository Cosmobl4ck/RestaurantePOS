<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MarrocosPOS - Asistencia</title>
    <link rel="icon" href="/img/logo-icon.svg">
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/bootstrap-icons/font/bootstrap-icons.css">
    <style nonce="<%= cspNonce %>">
        body { background-color: #08090A; color: #E8EAED; }
        .card-asistencia { max-width: 1100px; margin: 30px auto 50px; }
        .table-asistencia { --bs-table-bg: transparent; }
        .table-asistencia th {
            font-size: .72rem; letter-spacing: .06em; text-transform: uppercase;
            color: #9AA6AD; font-weight: 600;
        }
        .table-asistencia td { vertical-align: middle; }
    </style>
    <link rel="stylesheet" href="/css/petronas.css?v=petronas2">
</head>
<body>
<%- include('partials/navbar') %>

    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
            <h2 class="h4 mb-0"><i class="bi bi-calendar3 me-2"></i>Historial de asistencia</h2>
            <div class="d-flex gap-2">
                <a href="/register/faltas" class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-person-exclamation me-1"></i>Faltas de empleados
                </a>
                <a href="/register" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Volver a Personal
                </a>
            </div>
        </div>

        <div class="card shadow card-asistencia">
            <div class="card-body">
                <form method="GET" action="/register/asistencia" class="row g-2 align-items-end mb-3">
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="desde">Desde</label>
                        <input type="date" class="form-control" id="desde" name="desde" value="<%= desde %>">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="hasta">Hasta</label>
                        <input type="date" class="form-control" id="hasta" name="hasta" value="<%= hasta %>">
                    </div>
                    <div class="col-md-6 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-funnel me-1"></i>Filtrar
                        </button>
                        <a href="/register/asistencia" class="btn btn-outline-secondary">Últimos 7 días</a>
                    </div>
                </form>

                <p class="text-muted small mb-2">
                    Zona horaria: <strong><%= timezone %></strong>.
                    Entrada = primer login del día; salida = último logout.
                </p>

                <% if (!filas.length) { %>
                    <p class="text-center text-muted py-4 mb-0">Sin registros de asistencia en este rango.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover table-asistencia align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Día</th>
                                    <th>Empleado</th>
                                    <th>Rol</th>
                                    <th>Entrada</th>
                                    <th>Salida</th>
                                    <th>IP entrada</th>
                                    <th>IP salida</th>
                                </tr>
                            </thead>
                            <tbody>
                                <%
                                  const etiquetasRol = { admin: 'Administrador', gerente: 'Gerente', cajero: 'Cajero', host: 'Host', mesero: 'Mesero', cocina: 'Cocina', bar: 'Bar' };
                                %>
                                <% filas.forEach(function(f) { %>
                                    <tr>
                                        <td class="text-nowrap"><%= f.dia %></td>
                                        <td class="fw-semibold"><%= f.empleado %></td>
                                        <td><span class="badge text-bg-secondary"><%= etiquetasRol[f.rol] || f.rol %></span></td>
                                        <td class="text-success fw-semibold"><%= f.entrada || '—' %></td>
                                        <td class="text-info fw-semibold"><%= f.salida || '—' %></td>
                                        <td class="small text-muted"><%= f.ip_entrada || '—' %></td>
                                        <td class="small text-muted"><%= f.ip_salida || '—' %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
