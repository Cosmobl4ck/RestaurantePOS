<!-- views/login.ejs -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | MarrocosPOS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f8f9fa; height: 100vh; display: flex; align-items: center; }
        .login-card { border-radius: 20px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
        .btn-login { border-radius: 10px; padding: 12px; font-weight: bold; }
        .form-control { border-radius: 10px; padding: 12px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card login-card p-4">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">Marrocos<span class="text-primary">POS</span></h2>
                        <p class="text-muted">Ingresa a tu punto de venta</p>
                    </div>

                    <% if (error) { %>
                        <div class="alert alert-danger py-2 small text-center"><%= error %></div>
                    <% } %>

                    <form action="/login" method="POST">
                        <!-- CAMPO 1: CÓDIGO DE NEGOCIO -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Código de Negocio</label>
                            <input type="text" name="codigo_negocio" class="form-control" placeholder="Ej: MX-A12" required autofocus>
                        </div>

                        <!-- CAMPO 2: NOMBRE DE USUARIO -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Usuario</label>
                            <input type="text" name="nombre" class="form-control" placeholder="Tu nombre" required>
                        </div>

                        <!-- CAMPO 3: PIN DE ACCESO -->
                        <div class="mb-4">
                            <label class="form-label small fw-bold">PIN de Seguridad</label>
                            <input type="password" name="pin" class="form-control" placeholder="****" inputmode="numeric" required>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-login shadow-sm">
                            Iniciar Sesión <i class="bi bi-arrow-right-short"></i>
                        </button>
                    </form>
                    
                    <div class="text-center mt-4">
                        <small class="text-muted">¿No tienes cuenta? <a href="#">Contactar a Ventas</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>