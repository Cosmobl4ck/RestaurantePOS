<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#00A19C">
<link rel="apple-touch-icon" href="/img/logo-500.svg">
<link rel="stylesheet" href="/css/pwa-install.css">

<section class="mp-install-banner" id="mpInstallBanner" hidden aria-label="Instalar MarrocosPOS">
    <div class="mp-install-banner__content">
        <img class="mp-install-banner__icon" src="/img/logo-500.svg" alt="">
        <div>
            <p class="mp-install-banner__title">Instala MarrocosPOS</p>
            <p class="mp-install-banner__copy">Ábrelo como una app desde la pantalla principal de este dispositivo.</p>
        </div>
    </div>
    <div class="mp-install-banner__actions">
        <button type="button" class="btn btn-primary btn-sm" id="mpInstallButton">Instalar app</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="mpInstallDismiss">Ahora no</button>
    </div>
</section>
<script src="/js/pwa-install.js" defer></script>
