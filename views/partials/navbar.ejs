<style>
    :root { --mp-accent:#00A19C; --mp-bg:#08090A; --mp-surface:#0D0E10; --mp-text:#E8EAED; --mp-muted:#9AA6AD; }
    body { background-color: var(--mp-bg); color: var(--mp-text); }
    .card { border: 1px solid #1A1D20; border-radius: 14px; box-shadow: 0 18px 45px rgba(0,0,0,.45); }
    .table { --bs-table-bg: transparent; }
    .form-control:focus, .form-select:focus, .btn:focus-visible { border-color: var(--mp-accent); box-shadow: 0 0 0 .2rem rgba(0,161,156,.22); }
    @media (max-width: 991.98px) { .navbar-custom .user-badge { width:100%; justify-content:center; } }

    /* Estilos base del Navbar - Carbono Petronas */
    .navbar-custom {
        background-color: #0D0E10; /* Carbono Petronas */
        box-shadow: 0 1px 0 rgba(0,161,156,.55), 0 8px 26px rgba(0,0,0,.50);
        font-size: 1.1rem;
    }
    .navbar-custom .navbar-brand {
        color: #00A19C !important; /* Texto Acqua principal */
        font-weight: bold;
        font-size: 1.4rem;
    }
    .navbar-custom .navbar-brand .text-business {
        color: #E8EAED !important; /* Plata para el nombre del negocio */
    }
    
    /* Botones Acqua personalizados */
    .btn-outline-aqua {
        color: #00D2BE;
        border: 1px solid rgba(0, 210, 190, 0.55);
        background: transparent;
        transition: all 0.2s ease-in-out;
    }
    .btn-outline-aqua:hover {
        background-color: rgba(0, 161, 156, 0.18); /* Brillo teal translúcido */
        color: #00D2BE;
        border-color: #00D2BE;
    }
    .btn-solid-aqua {
        background-color: #00A19C;
        color: #06110F;
        border: 1px solid #00A19C;
        font-weight: bold;
    }
    .btn-solid-aqua:hover {
        background-color: #00D2BE;
        color: #06110F;
    }

    /* Estilo para el usuario logueado */
    .user-badge {
        background-color: rgba(0, 0, 0, 0.3); /* Fondo carbón más oscuro */
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        color: #00A19C; /* Texto y logo Acqua */
        font-size: 0.9rem;
        border: 1px solid rgba(0, 161, 156, 0.4); /* Borde Acqua sutil */
    }
    
    /* Resaltado de página activa */
    .nav-active {
        background-color: #00A19C !important;
        color: #06110F !important; /* Ícono en carbono para resaltar */
        border-color: #00A19C !important;
        box-shadow: 0 0 12px rgba(0, 161, 156, 0.45); /* Resplandor teal */
    }
</style>

<nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
    <div class="container">
        <a class="navbar-brand" href="/dashboard">
            <img src="/img/logo-icon-white.svg" alt="Logo" width="30" height="30" class="d-inline-block align-text-top" style="filter: drop-shadow(0px 0px 2px #00A19C);">
            MarrocosPOS 
            <% if (locals.usuario && usuario.nombre_negocio) { %>
                | <span class="fw-light small text-business"><%= usuario.nombre_negocio %></span>
            <% } else { %>
                | <span class="fw-light small text-business">Demo</span>
            <% } %>
        </a>
        
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" style="border-color: rgba(0,161,156,0.5);">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">
            <div class="d-flex flex-wrap ms-auto align-items-center gap-2 mt-3 mt-lg-0">
                
                <% if (locals.usuario) { %>
                    <% const puede = (featureKey) => typeof locals.planPuede === 'function' ? locals.planPuede(featureKey) : true; %>
                    
                    <!-- DASHBOARD: Solo Admin -->
                    <% if (['admin', 'gerente'].includes(usuario.rol)) { %>
                        <a href="/dashboard" class="btn btn-outline-aqua <%= locals.page === 'dashboard' ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Panel de Ventas">
                            <i class="bi bi-grid-fill"></i>
                        </a>
                    <% } %>

                    <!-- MESAS: Admin, Cajero y Mesero -->
                    <% if (['admin', 'gerente', 'cajero', 'mesero'].includes(usuario.rol) && puede('pos.mesas')) { %>
                        <a href="/mesas" class="btn btn-outline-aqua <%= locals.page === 'mesas' ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Mesas y Mostrador">
                            <i class="bi bi-grid"></i>
                        </a>
                    <% } %>

                    <!-- INVENTARIO / MENÚ: Admin y Cajero -->
                    <% if (['admin', 'gerente', 'cajero'].includes(usuario.rol) && puede('menu.productos')) { %>
                        <a href="/productos" class="btn btn-outline-aqua <%= locals.page === 'productos' ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Inventario y Menú">
                            <i class="bi bi-box"></i>
                        </a>
                    <% } %>

                    <!-- CAJA, PEDIDOS, FACTURAS Y REPORTES: Admin y Cajero -->
                    <% if (['admin', 'gerente', 'cajero'].includes(usuario.rol)) { %>
                        <% if (puede('caja.basica')) { %>
                        <a href="/caja" class="btn btn-outline-aqua <%= locals.page === 'caja' ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Movimientos de Caja">
                            <i class="bi bi-cart-check"></i>
                        </a>
                        <% } %>
                        <% if (puede('pos.pedidos')) { %>
                        <a href="/registro-pedidos" class="btn btn-outline-aqua <%= locals.page === 'registro-pedidos' ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Registro de Pedidos">
                            <i class="bi bi-list-check"></i>
                        </a>
                        <% } %>
                        <% if (puede('facturas.internas')) { %>
                        <a href="/facturas" class="btn btn-outline-aqua <%= locals.page === 'facturas' ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Facturas">
                            <i class="bi bi-receipt-cutoff"></i>
                        </a>
                        <% } %>
                        <% if (puede('ventas.historial')) { %>
                        <a href="/ventas" class="btn btn-outline-aqua <%= locals.page === 'ventas' ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Ventas">
                            <i class="bi bi-cash-coin"></i>
                        </a>
                        <% } %>
                        <% if (puede('reportes.basicos')) { %>
                        <a href="/reportes" class="btn btn-outline-aqua <%= locals.page === 'reportes' ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Reportes">
                            <i class="bi bi-bar-chart-line"></i>
                        </a>
                        <% } %>
                    <% } %>

                    <!-- CLIENTES: Admin, Cajero y Mesero -->
                    <% if (['admin', 'gerente', 'cajero', 'mesero'].includes(usuario.rol) && puede('clientes')) { %>
                        <a href="/clientes" class="btn btn-outline-aqua <%= locals.page === 'clientes' ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Clientes">
                            <i class="bi bi-people"></i>
                        </a>
                    <% } %>

                    <!-- MONITOR DE COCINA: Admin y Cocina -->
                    <% if (['admin', 'gerente', 'cajero', 'cocina'].includes(usuario.rol) && puede('kds.cocina')) { %>
                        <a href="/kds/cocina" class="btn btn-outline-aqua <%= locals.currentPath && locals.currentPath.startsWith('/kds/cocina') ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Monitor de Cocina">
                            <i class="bi bi-egg-fried"></i>
                        </a>
                    <% } %>

                    <!-- MONITOR DE BAR: Admin y Bar -->
                    <% if (['admin', 'gerente', 'cajero', 'bar'].includes(usuario.rol) && puede('kds.bar')) { %>
                        <a href="/kds/bar" class="btn btn-outline-aqua <%= locals.currentPath && locals.currentPath.startsWith('/kds/bar') ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Monitor de Bar">
                            <i class="bi bi-cup-straw"></i>
                        </a>
                    <% } %>


                    <% if (['admin', 'gerente'].includes(usuario.rol) && puede('areas.croquis')) { %>
                        <a href="/areas" class="btn btn-outline-aqua <%= locals.page === 'areas' ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Croquis y áreas del restaurante">
                            <i class="bi bi-bounding-box-circles"></i>
                        </a>
                    <% } %>

                    <% if (['admin', 'gerente', 'cajero'].includes(usuario.rol) && puede('inventario.desperdicios')) { %>
                        <a href="/desperdicios" class="btn btn-outline-aqua <%= locals.page === 'desperdicios' ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Control de desperdicios">
                            <i class="bi bi-trash3"></i>
                        </a>
                    <% } %>

                    <% if (['admin', 'gerente'].includes(usuario.rol) && puede('configuracion.basica')) { %>
                        <a href="/configuracion" class="btn btn-outline-aqua <%= locals.page === 'configuracion' ? 'nav-active' : '' %>" data-bs-toggle="tooltip" title="Configuración del negocio">
                            <i class="bi bi-gear"></i>
                        </a>
                    <% } %>

                    <!-- GESTIÓN DE PERSONAL: Solo Admin -->
                    <% if (['admin', 'gerente'].includes(usuario.rol) && puede('usuarios')) { %>
                        <a href="/register" class="btn btn-solid-aqua ms-lg-2" data-bs-toggle="tooltip" title="Gestión de Personal">
                            <i class="bi bi-person-plus"></i> <span class="d-none d-lg-inline">Personal</span>
                        </a>
                    <% } %>

                    <% if (['admin', 'gerente'].includes(usuario.rol)) { %>
                        <a href="/mi-plan" class="btn btn-outline-aqua" data-bs-toggle="tooltip" title="Mi plan y límites">
                            <i class="bi bi-gem"></i>
                        </a>
                    <% } %>

                    <div class="vr mx-2 d-none d-lg-block" style="background-color: #00A19C; opacity: 0.3;"></div>

                    <!-- BADGE DE USUARIO -->
                    <div class="user-badge ms-2 ms-lg-0 mb-2 mb-lg-0 d-flex align-items-center">
                        <i class="bi bi-person-circle me-2"></i>
                        <span class="fw-bold me-1 text-light"><%= usuario.nombre %></span> 
                        <span class="badge ms-1 text-uppercase" style="background-color: #00A19C; color: #06110F; font-size: 0.7rem;">
                            <%= usuario.rol %>
                        </span>
                        <span class="badge ms-1" style="font-size: 0.7rem; background-color: transparent; border: 1px solid #00A19C; color: #00A19C; text-transform: uppercase;">
                            <%= (locals.planLabel || usuario.plan || 'trial').toUpperCase().replace(/_/g, ' ') %>
                        </span>
                    </div>
                    
                    <!-- BOTÓN SALIR -->
                    <form action="/logout" method="post" class="d-inline ms-2">
                        <button type="submit" class="btn btn-outline-aqua btn-sm" data-bs-toggle="tooltip" title="Cerrar Sesión">
                            <i class="bi bi-box-arrow-right"></i> <span class="d-none d-lg-inline">Salir</span>
                        </button>
                    </form>

                <% } %>

            </div>
        </div>
    </div>
</nav>

<script>
    document.addEventListener("DOMContentLoaded", function(){
        // Inicializar tooltips de Bootstrap
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        if (window.bootstrap && bootstrap.Tooltip) {
            tooltipTriggerList.map(function (tooltipTriggerEl) { return new bootstrap.Tooltip(tooltipTriggerEl); });
        }
    });
</script>
