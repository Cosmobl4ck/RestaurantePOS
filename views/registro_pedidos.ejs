<%- include('partials/navbar') %>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-4"><i class="bi bi-list-check me-2"></i>Registro de Pedidos</h2>

            <!-- FILTROS -->
            <div class="card mb-4">
                <div class="card-body">
                    <form id="formFiltros" class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label">Desde</label>
                            <input type="date" class="form-control" name="desde" value="<%= filtros.desde %>">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Hasta</label>
                            <input type="date" class="form-control" name="hasta" value="<%= filtros.hasta %>">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Mesa</label>
                            <select class="form-select" name="mesa_id">
                                <option value="">Todas</option>
                                <% (mesas || []).forEach(m => { %>
                                    <option value="<%= m.id %>" <%= filtros.mesa_id == m.id ? 'selected' : '' %>>
                                        Mesa <%= m.numero %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Estado</label>
                            <select class="form-select" name="estado">
                                <option value="">Todos</option>
                                <option value="abierto" <%= filtros.estado === 'abierto' ? 'selected' : '' %>>Abierto</option>
                                <option value="cerrado" <%= filtros.estado === 'cerrado' ? 'selected' : '' %>>Cerrado</option>
                                <option value="cancelado" <%= filtros.estado === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-funnel me-1"></i>Filtrar
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- RESUMEN -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h6 class="text-muted">Total Pedidos</h6>
                            <h3 class="mb-0"><%= pedidos.length %></h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h6 class="text-muted">Abiertos</h6>
                            <h3 class="mb-0 text-warning">
                                <%= pedidos.filter(p => p.estado === 'abierto').length %>
                            </h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h6 class="text-muted">Cerrados</h6>
                            <h3 class="mb-0 text-success">
                                <%= pedidos.filter(p => p.estado === 'cerrado').length %>
                            </h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h6 class="text-muted">Total Ventas</h6>
                            <h3 class="mb-0">
                                $<%= pedidos.reduce((sum, p) => sum + (p.total || 0), 0).toLocaleString('es-CO') %>
                            </h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABLA -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Pedidos del período</h5>
                </div>
                <div class="card-body">
                    <% if (pedidos.length === 0) { %>
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            No hay pedidos en el período seleccionado.
                        </div>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Hora</th>
                                        <th>Mesa</th>
                                        <th>Cliente</th>
                                        <th>Items</th>
                                        <th>Total</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% pedidos.forEach(p => { %>
                                        <tr>
                                            <td>
                                                <small class="text-muted">
                                                    <%= new Date(p.created_at).toLocaleTimeString('es-SV', {hour: '2-digit', minute: '2-digit'}) %>
                                                </small>
                                            </td>
                                            <td>
                                                <strong>
                                                    <% if (p.mesas) { %>
                                                        <%= p.mesas.numero %>
                                                    <% } else { %>
                                                        #<%= p.id %>
                                                    <% } %>
                                                </strong>
                                            </td>
                                            <td>
                                                <% if (p.clientes) { %>
                                                    <%= p.clientes.nombre %>
                                                <% } else { %>
                                                    <span class="text-muted">-</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark">
                                                    <%= p.pedido_items.length %> items
                                                </span>
                                            </td>
                                            <td>
                                                <strong>$<%= Number(p.total || 0).toLocaleString('es-CO') %></strong>
                                            </td>
                                            <td>
                                                <% const badges = {
                                                    abierto: 'warning',
                                                    cerrado: 'success',
                                                    cancelado: 'danger'
                                                } %>
                                                <span class="badge bg-<%= badges[p.estado] || 'secondary' %>">
                                                    <%= p.estado %>
                                                </span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary btn-detalle" 
                                                    data-id="<%= p.id %>"
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#modalDetalle">
                                                    <i class="bi bi-eye"></i> Ver
                                                </button>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- BOTONES -->
            <div class="row mt-4">
                <div class="col-md-6">
                    <button class="btn btn-outline-secondary w-100" id="btnReporte">
                        <i class="bi bi-bar-chart me-2"></i>Generar Reporte
                    </button>
                </div>
                <div class="col-md-6">
                    <button class="btn btn-outline-secondary w-100" id="btnExport">
                        <i class="bi bi-file-earmark-excel me-2"></i>Exportar a Excel
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- MODAL DETALLE -->
<div class="modal fade" id="modalDetalle" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalle del Pedido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalDetalleBody">
                <p class="text-muted">Cargando...</p>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[ch]));
}
// Ver detalle del pedido
document.querySelectorAll('.btn-detalle').forEach(btn => {
    btn.addEventListener('click', async function() {
        const id = this.dataset.id;
        try {
            const resp = await fetch(`/registro-pedidos/detalle/${id}`);
            if (!resp.ok) throw new Error('Error al cargar');
            const pedido = await resp.json();

            let html = `
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Mesa:</strong> ${escapeHtml(pedido.mesas?.numero || 'N/A')}</p>
                        <p><strong>Cliente:</strong> ${escapeHtml(pedido.clientes?.nombre || '-')}</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Hora:</strong> ${new Date(pedido.created_at).toLocaleTimeString('es-SV')}</p>
                        <p><strong>Estado:</strong> <span class="badge bg-primary">${escapeHtml(pedido.estado)}</span></p>
                    </div>
                </div>
                <hr>
                <h6>Items del Pedido</h6>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-end">Precio Unit.</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            (pedido.pedido_items || []).forEach(it => {
                html += `
                    <tr>
                        <td>${escapeHtml(it.productos?.nombre || 'Producto')}</td>
                        <td class="text-center">${it.cantidad}</td>
                        <td class="text-end">$${Number(it.precio_unitario).toLocaleString('es-CO')}</td>
                        <td class="text-end"><strong>$${Number(it.subtotal).toLocaleString('es-CO')}</strong></td>
                    </tr>
                `;
            });

            html += `
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">TOTAL:</th>
                            <th class="text-end"><strong>$${Number(pedido.total).toLocaleString('es-CO')}</strong></th>
                        </tr>
                    </tfoot>
                </table>
            `;

            document.getElementById('modalDetalleBody').innerHTML = html;
        } catch (err) {
            document.getElementById('modalDetalleBody').innerHTML = `
                <div class="alert alert-danger">Error: ${escapeHtml(err.message)}</div>
            `;
        }
    });
});

// Filtros
document.getElementById('formFiltros').addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const params = new URLSearchParams(formData);
    window.location.search = params.toString();
});

// Reporte
document.getElementById('btnReporte').addEventListener('click', async function() {
    const desde = document.querySelector('input[name="desde"]').value;
    const hasta = document.querySelector('input[name="hasta"]').value;

    try {
        Swal.fire({ title: 'Generando reporte...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

        const resp = await fetch(`/registro-pedidos/reporte?desde=${desde}&hasta=${hasta}`);
        if (!resp.ok) throw new Error('Error');
        const data = await resp.json();

        let html = `<h4>Reporte de Pedidos</h4>
            <p><strong>Período:</strong> ${data.periodo.desde} a ${data.periodo.hasta}</p>
            <hr>
            <div class="row">
                <div class="col-md-6"><p><strong>Total Pedidos:</strong> ${data.resumen.total_pedidos}</p></div>
                <div class="col-md-6"><p><strong>Total Ventas:</strong> $${data.resumen.total_ventas}</p></div>
                <div class="col-md-6"><p><strong>Promedio:</strong> $${data.resumen.promedio_venta}</p></div>
                <div class="col-md-6"><p><strong>Completos:</strong> ${data.resumen.pedidos_completos}</p></div>
            </div>`;

        Swal.fire({ title: 'Reporte', html, width: '600px', confirmButtonText: 'Cerrar' });
    } catch (err) {
        Swal.fire({ icon: 'error', title: 'Error', text: err.message });
    }
});
</script>
