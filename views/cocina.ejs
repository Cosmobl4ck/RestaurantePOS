<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cocina</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body{background-color:#08090A;color:#E8EAED}
        .navbar{background-color:#0D0E10;box-shadow:0 1px 0 rgba(0,161,156,.55),0 8px 26px rgba(0,0,0,.5)}
        .navbar-brand{color:#00A19C!important;font-weight:bold}
        .producto{font-size:1.2rem;font-weight:700}
        .cantidad-badge{font-size:1rem}
        .mesa-heading{background:#121518;color:#E8EAED;border:1px solid #1A1D20;border-radius:.5rem;padding:.4rem .75rem;margin:.25rem 0;font-weight:600}
        .card-cocina{border:1px solid #1A1D20;box-shadow:0 12px 28px rgba(0,0,0,.35)}
        .item-row{border:1px solid #1A1D20;border-radius:.5rem;padding:.6rem .75rem;background:#0D0E10}
    </style>
    <link rel="stylesheet" href="/css/petronas.css?v=petronas1">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container">
        <h4 class="mb-3"><i class="bi bi-egg-fried me-2"></i>Cola de Cocina</h4>
        <ul class="nav nav-tabs" id="tabsCocina" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link active" id="tabCola-tab" data-bs-toggle="tab" href="#tabCola" data-bs-target="#tabCola" role="tab" aria-controls="tabCola" aria-selected="true">
                    En cocina
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" id="tabListos-tab" data-bs-toggle="tab" href="#tabListos" data-bs-target="#tabListos" role="tab" aria-controls="tabListos" aria-selected="false">
                    Listos
                </a>
            </li>
        </ul>
        <div class="tab-content pt-3">
            <div class="tab-pane fade show active" id="tabCola" role="tabpanel" aria-labelledby="tabCola-tab">
                <div class="card">
                    <div class="card-header">En cola / Preparando</div>
                    <div class="card-body">
                        <div id="listaCola" class="vstack gap-2"></div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="tabListos" role="tabpanel" aria-labelledby="tabListos-tab">
                <div class="card">
                    <div class="card-header">Listos</div>
                    <div class="card-body">
                        <div id="listaListos" class="vstack gap-2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/cocina.js"></script>
</body>
</html>


