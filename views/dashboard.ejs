<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Facturación</title>
    <link rel="icon" href="/img/logo-icon.svg">
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/vendor/select2/select2.min.css" rel="stylesheet" />
    <link href="/vendor/select2/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/vendor/bootstrap-icons/font/bootstrap-icons.css">
    <style nonce="<%= cspNonce %>">
        body {
            background-color: #08090A;
            color: #E8EAED;
            font-size: 16px;
            display: flex;
            flex-direction: column;
            min-height: 100vh; /* Asegura que el body ocupe toda la pantalla para el footer */
        }
        
        .search-results {
            position: absolute;
            width: 100%;
            top: 100%;
            left: 0;
            margin-top: 2px;
            box-shadow: 0 18px 45px rgba(0,0,0,.45);
            z-index: 1000;
            background-color: #0D0E10;
            color: #E8EAED;
            border: 1px solid #22262A;
            border-radius: 4px;
            max-height: 300px;
            overflow-y: auto;
        }
        
        .search-container {
            position: relative;
        }
        .navbar {
            background-color: #0D0E10;
            box-shadow: 0 1px 0 rgba(0,161,156,.55), 0 8px 26px rgba(0,0,0,.50);
            font-size: 1.1rem;
        }
        .navbar-brand {
            color: #00A19C !important;
            font-weight: bold;
            font-size: 1.4rem;
        }
        .card {
            border: 1px solid #1A1D20;
            box-shadow: 0 18px 45px rgba(0, 0, 0, .45);
            margin-bottom: 1.5rem;
        }
        .card-header {
            background-color: #121518;
            color: #E8EAED;
            border-bottom: 1px solid #1A1D20;
            font-weight: 600;
            font-size: 1.2rem;
        }
        .btn-primary {
            background-color: #00A19C;
            border-color: #00A19C;
            color: #06110F;
        }
        .btn-primary:hover {
            background-color: #00D2BE;
            border-color: #00D2BE;
            color: #06110F;
        }
        .btn-success {
            background-color: #00D2BE;
            border-color: #00D2BE;
            color: #06110F;
        }
        .btn-success:hover {
            background-color: #00A19C;
            border-color: #00A19C;
            color: #06110F;
        }
        .select2-container--bootstrap-5 .select2-selection {
            border: 1px solid #22262A;
            padding: 0.375rem 0.75rem;
            height: calc(3.5rem + 2px);
        }
        .table {
            background-color: transparent;
            font-size: 1.1rem;
        }
        .shortcut-hint {
            color: #9AA6AD;
            font-size: 0.8rem;
            margin-left: 0.5rem;
        }
        .action-buttons {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            z-index: 1000;
        }
        .action-buttons .btn {
            width: 3.5rem;
            height: 3.5rem;
            border-radius: 50%;
            margin-left: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }
        .floating-total {
            position: fixed;
            bottom: 2rem;
            left: 2rem;
            z-index: 1000;
            background-color: #0D0E10;
            color: #E8EAED;
            border: 1px solid rgba(0,161,156,.35);
            padding: 1rem 2rem;
            border-radius: 2rem;
            box-shadow: 0 18px 45px rgba(0, 0, 0, .45);
        }
        .form-control {
            font-size: 1.1rem;
            padding: 0.5rem 1rem;
        }
        .btn {
            font-size: 1.1rem;
        }

        /* --- NUEVOS ESTILOS DEL FOOTER --- */
        .footer-custom {
            background-color: #0D0E10;
            border-top: 1px solid #1A1D20;
            margin-top: auto; /* Lo empuja al final de la pantalla */
        }
        .footer-custom .btn-pill {
            border-radius: 50px;
            padding: 0.5rem 1.5rem;
            font-weight: 500;
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            min-width: 140px;
        }
        .footer-custom .btn-pill:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        }
        .footer-custom .btn-pill i {
            margin-right: 6px;
            font-size: 1.1rem;
        }
        .footer-custom .text-copyright {
            color: #9AA6AD;
            font-size: 0.95rem;
        }
        @media (max-width: 767.98px) {
            .footer-custom .btn-pill {
                width: 80%;
                margin: 0.25rem auto;
                display: block;
            }
        }
        /* --------------------------------- */

        /* Animación de vibración para errores */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-8px); }
            50% { transform: translateX(8px); }
            75% { transform: translateX(-8px); }
        }
        .shake {
            animation: shake 0.4s ease-in-out;
            border: 2px solid #EF4444 !important;
        }

        /* Animación de entrada suave al cargar */
        .fade-in {
            animation: fadeIn 1.2s ease-out;
        }

        /* Animación de flotado (levitación) */
        .logo-animated {
            animation: float 4s ease-in-out infinite;
            filter: drop-shadow(0 5px 15px rgba(0,0,0,0.1));
        }
        .dashboard-hero-logo {
            width: 100%;
            max-width: min(300px, 55vw);
        }
        @media (max-width: 575.98px) {
            .dashboard-main {
                min-height: auto !important;
                padding: 2rem 0 1rem;
            }
            .dashboard-hero-logo {
                max-width: min(210px, 52vw);
            }
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }

    </style>
    <link rel="stylesheet" href="/css/petronas.css?v=petronas2">
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="dashboard-main d-flex flex-column align-items-center justify-content-center flex-grow-1" style="min-height: 70vh;">
        <div class="text-center fade-in">
            <img src="/img/logo-500.svg" alt="MarrocosPOS" class="img-fluid logo-animated dashboard-hero-logo">
            <h2 class="mt-4 text-muted fw-light">Bienvenido, <%= locals.usuario ? usuario.nombre : 'Usuario' %></h2>
        </div>
    </main>

    <!-- FOOTER ACTUALIZADO -->
    <footer class="footer-custom mt-5 py-4">
        <div class="container">
            <div class="row justify-content-center align-items-center g-3">
                <div class="col-12 col-md-auto text-center">
                    <a href="https://wa.me/50373297072" target="_blank" class="btn btn-success btn-pill mx-1 mb-2 mb-md-0">
                        <i class="bi bi-whatsapp"></i> WhatsApp
                    </a>
                </div>
                <div class="col-12 col-md-auto text-center">
                    <a href="https://marrocosdesign.com/" target="_blank" class="btn btn-primary btn-pill mx-1">
                        <i class="bi bi-person-badge"></i> Creado por Henrry Marroquín
                    </a>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-12 text-center">
                    <p class="mb-0 text-copyright">
                        &copy; <%= new Date().getFullYear() %> <span class="fw-bold text-white">MarrocosDesign</span> - Todos los derechos reservados
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <div class="modal fade" id="nuevoClienteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-person-plus-fill me-2"></i>
                        Nuevo Cliente
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="formNuevoCliente">
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="nombreCliente" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Dirección</label>
                            <input type="text" class="form-control" id="direccionNuevoCliente">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Teléfono</label>
                            <input type="text" class="form-control" id="telefonoNuevoCliente">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="guardarCliente">
                        <i class="bi bi-save me-1"></i>
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="pedidosModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Pedidos Guardados</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Cliente</th>
                                    <th>Productos</th>
                                    <th>Total</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="pedidosGuardados"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="facturaModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Factura</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <iframe id="facturaFrame" style="width: 100%; height: 80vh; border: none;"></iframe>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="btn-imprimir-factura">
                        <i class="bi bi-printer"></i> Imprimir
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="/vendor/jquery/jquery-3.6.0.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/vendor/select2/select2.min.js"></script>
    <script src="/vendor/sweetalert2/sweetalert2.all.min.js"></script>
    <link rel="stylesheet" href="/vendor/animate.css/animate.min.css">
    <script nonce="<%= cspNonce %>">
        // Función global para hacer vibrar elementos cuando algo sale mal
        function vibrarElemento(selector) {
            const el = $(selector);
            el.addClass('shake');
            setTimeout(() => el.removeClass('shake'), 500);
        }

        // Atajos de teclado físico adicionales
        document.addEventListener('keydown', function(e) {
            // Si presionas Escape, cerramos los resultados de búsqueda
            if (e.key === 'Escape') {
                $('#resultadosProductos').hide();
            }
            
            // Enter en el campo de cantidad agrega el producto
            if (e.key === 'Enter' && document.activeElement.id === 'cantidad') {
                e.preventDefault();
                $('#agregarProducto').click();
            }
        });

        // Inicializar tooltips de Bootstrap
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        document.getElementById('btn-imprimir-factura').addEventListener('click', () => {
            document.getElementById('facturaFrame').contentWindow.print();
        });
    </script>
</body>
</html>
