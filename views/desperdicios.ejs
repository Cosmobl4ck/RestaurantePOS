<%- include('partials/navbar') %>

<body>
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-12">

            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-trash3 me-2"></i>Control de Desperdicios</h2>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalRegistrar">
                    <i class="bi bi-plus-circle me-1"></i>Registrar Desperdicio
                </button>
            </div>

            <!-- KPI DASHBOARD -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <small class="text-muted">Registros totales</small>
                            <h2 class="fw-bold mt-1"><%= stats.totalRegistros %></h2>
                            <i class="bi bi-clipboard-data fs-1 text-primary opacity-25"></i>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <small class="text-muted">Cantidad desperdiciada</small>
                            <h2 class="fw-bold mt-1"><%= stats.totalCantidad %></h2>
                            <i class="bi bi-box-seam fs-1 text-danger opacity-25"></i>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <small class="text-muted">Producto más desperdiciado</small>
                            <h5 class="fw-bold mt-2"><%= stats.topProducto %></h5>
                            <i class="bi bi-exclamation-triangle fs-1 text-warning opacity-25"></i>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <small class="text-muted">Motivo principal</small>
                            <h5 class="fw-bold mt-2 text-capitalize"><%= stats.topMotivo %></h5>
                            <i class="bi bi-pie-chart fs-1 text-success opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FILTROS -->
            <div class="card mb-4">
                <div class="card-body">
                    <form id="formFiltros" class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label">Desde</label>
                            <input type="date" class="form-control" name="desde" value="<%= filtros.desde %>">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Hasta</label>
                            <input type="date" class="form-control" name="hasta" value="<%= filtros.hasta %>">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Producto</label>
                            <select class="form-select" name="producto_id">
                                <option value="">Todos</option>
                                <% (productos || []).forEach(p => { %>
                                    <option value="<%= p.id %>" <%= filtros.producto_id == p.id ? 'selected' : '' %>>
                                        <%= p.nombre %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Motivo</label>
                            <select class="form-select" name="motivo">
                                <option value="">Todos</option>
                                <option value="vencimiento" <%= filtros.motivo === 'vencimiento' ? 'selected' : '' %>>Vencimiento</option>
                                <option value="accidente" <%= filtros.motivo === 'accidente' ? 'selected' : '' %>>Accidente</option>
                                <option value="merma" <%= filtros.motivo === 'merma' ? 'selected' : '' %>>Merma</option>
                                <option value="deterioro" <%= filtros.motivo === 'deterioro' ? 'selected' : '' %>>Deterioro</option>
                                <option value="otro" <%= filtros.motivo === 'otro' ? 'selected' : '' %>>Otro</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-outline-primary w-100">
                                <i class="bi bi-funnel me-1"></i>Filtrar
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- TABLA -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        Registros recientes 
                        <span class="badge bg-secondary"><%= desperdicios.length %> items</span>
                    </h5>
                </div>
                <div class="card-body">
                    <% if (desperdicios.length === 0) { %>
                        <div class="alert alert-info">
                            No hay registros de desperdicios en este período.
                        </div>
                    <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Motivo</th>
                                    <th>Notas</th>
                                    <th>Registrado por</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% desperdicios.forEach(d => { %>
                                <tr>
                                    <td>
                                        <small>
                                            <%= new Date(d.created_at).toLocaleDateString('es-SV') %>
                                            <%= new Date(d.created_at).toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'}) %>
                                        </small>
                                    </td>
                                    <td><strong><%= d.productos?.nombre || 'Producto eliminado' %></strong></td>
                                    <td><%= d.cantidad %> <%= d.unidad_medida %></td>
                                    <td><span class="badge bg-secondary"><%= d.motivo %></span></td>
                                    <td><%= d.notas || '-' %></td>
                                    <td><%= d.usuarios?.nombre || '-' %></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger btn-eliminar" data-id="<%= d.id %>">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- REPORTES -->
            <div class="row mt-4">
                <div class="col-md-6">
                    <button class="btn btn-outline-secondary w-100" id="btnReporte">
                        Generar Reporte
                    </button>
                </div>
                <div class="col-md-6">
                    <button class="btn btn-outline-secondary w-100" id="btnExport">
                        Exportar Excel
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="modalRegistrar">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="formRegistrar">
        <div class="modal-header">
          <h5 class="modal-title">Registrar Desperdicio</h5>
          <button class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
            <select class="form-select mb-3" name="producto_id" required>
                <option value="">Producto</option>
                <% productos.forEach(p=>{ %>
                    <option value="<%= p.id %>"><%= p.nombre %></option>
                <% }) %>
            </select>

            <input class="form-control mb-3" name="cantidad" type="number" step="0.01" placeholder="Cantidad" required>

            <select class="form-select mb-3" name="motivo" required>
                <option value="">Motivo</option>
                <option value="vencimiento">Vencimiento</option>
                <option value="merma">Merma</option>
                <option value="accidente">Accidente</option>
                <option value="deterioro">Deterioro</option>
            </select>

            <textarea class="form-control" name="notas" placeholder="Notas"></textarea>
        </div>

        <div class="modal-footer">
            <button class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/desperdicios.js"></script>
</body>