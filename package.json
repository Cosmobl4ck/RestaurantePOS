{
  "name": "marrocos-pos",
  "version": "1.0.0",
  "description": "Sistema de Punto de Venta para Marrocos POS",
  "main": "server.js",
  "bin": {
    "ecl-fruver": "server.js"
  },
  "pkg": {
    "assets": [
      "views/**/*",
      "public/**/*",
      "node_modules/ejs/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "pkg . --public --target node18-win-x64",
    "check": "node scripts/verify-recovery.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.9",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cristiancano1236/sistema-restaurante.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Cristiancano1236/sistema-restaurante/issues"
  },
  "homepage": "https://github.com/Cristiancano1236/sistema-restaurante#readme"
}
