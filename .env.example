SUPABASE_URL=
# Clave moderna server-side (sb_secret_...). Preferida sobre la clave legada.
SUPABASE_SECRET_KEY=
# Compatibilidad temporal con proyectos que aun usan el JWT service_role.
SUPABASE_SERVICE_ROLE=

