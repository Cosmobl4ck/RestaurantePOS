SUPABASE_URL=
# Clave moderna server-side (sb_secret_...). Preferida sobre la clave legada.
SUPABASE_SECRET_KEY=
# Compatibilidad temporal con proyectos que aun usan el JWT service_role.
SUPABASE_SERVICE_ROLE=

# Obligatorio. Usa al menos 32 caracteres aleatorios (p. ej. openssl rand -hex 32).
SESSION_SECRET=
NODE_ENV=development
PORT=3010

# Proxy TLS/HTTP delante de la app. Sin proxy real déjalo vacío para evitar
# que un cliente falsifique X-Forwarded-For y evada el rate limiting.
# Ejemplos: TRUST_PROXY=1 (un proxy), TRUST_PROXY=true (confiar en todos).
TRUST_PROXY=

# Obliga a HTTPS en producción (actívalo solo con TLS real delante).
ENFORCE_HTTPS=false

# Cookies solo por HTTPS. Por defecto true en producción. Pon false si sirves
# el POS por HTTP en una LAN (sin TLS), o el login entrará en bucle.
COOKIE_SECURE=

# Máximo de peticiones API por IP cada 15 minutos (login y superadmin tienen
# límites propios más estrictos).
RATE_LIMIT_MAX=3000

# Segundos de caché para revalidar licencia/estado de usuario en cada sesión.
LICENSE_CACHE_TTL_MS=60000

# SuperAdmin (obligatorio para habilitar /superadmin). Usa HTTPS.
SUPERADMIN_USER=
SUPERADMIN_PASSWORD=
